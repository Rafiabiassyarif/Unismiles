BACKEND_URL=http://localhost:8000
KIOSK_API_KEY=replace-with-device-api-key
DEVICE_ID=KIOSK-001
LOCAL_BRIDGE_TOKEN=replace-with-a-local-random-token
LOCAL_BRIDGE_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
REQUIRE_LOCAL_BRIDGE_AUTH=true

LOCAL_BRIDGE_PORT=3001
HEARTBEAT_INTERVAL=20000

# Pilih disabled untuk instalasi awal; windows/cups dapat dipilih lewat admin
# setelah driver dan printer sudah terdeteksi.
PRINT_MODE=disabled
PRINTER_NAME=
PAPER_SIZE=4R
PRINT_ORIENTATION=portrait
PRINT_COPIES_LIMIT=2
PRINT_TIMEOUT_MS=60000
PRINT_RETRY_COUNT=2
PRINT_MAX_IMAGE_BYTES=15728640
