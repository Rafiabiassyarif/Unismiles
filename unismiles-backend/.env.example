NODE_ENV=development
PORT=8000
DB_HOST=127.0.0.1
DB_PORT=3305
DB_NAME=unismiles
DB_USER=root
DB_PASSWORD=
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1h
PUBLIC_BASE_URL=http://localhost:8000
# Origin yang diizinkan mengakses API dari browser. WAJIB memuat domain panel
# admin yang benar-benar dipakai — perhatikan EJAANNYA.
#
# Kejadian nyata: panel admin disajikan di unismilees.uniinside.net (dobel "e"),
# tetapi daftar ini hanya memuat unismiles.uniinside.net (satu "e") — domain
# yang bahkan tidak bisa di-resolve. Browser lalu memblokir permintaan sebelum
# terkirim, dan axios melaporkannya sebagai "Network error"; server tidak pernah
# melihat permintaannya sama sekali. Jangan pernah mencetak rahasia ke ringkasan.
CORS_ORIGINS=https://unismilees.uniinside.net,https://photobooth.uniinside.net,http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003
ALLOW_PUBLIC_REGISTRATION=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM="Uni-Smiles Photobooth <your-gmail-address@gmail.com>"
