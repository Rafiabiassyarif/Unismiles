PORT=3001

# To enable real AI Generation features, insert your Gemini API key below:
VITE_GEMINI_API_KEY=

# Production API base URL for admin dashboard.
# Must include the API prefix, e.g. https://api.example.com/api/v1
VITE_API_BASE_URL=https://api.example.com/api/v1

# Public base URL for backend assets (uploads, etc).
# Falls back to VITE_API_BASE_URL origin if empty.
VITE_PUBLIC_BASE_URL=https://api.example.com
